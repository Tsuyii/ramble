  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.28.1"
  }
}
