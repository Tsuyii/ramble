{
  "name": "ramble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Say it. I'll sort it. — a voice brain-dump that turns rambling speech into clean, scheduled tasks.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "electron:build": "electron-builder",
    "tauri": "tauri",
    "bundle:server": "esbuild server.js --bundle --platform=node --format=cjs --outfile=dist/server.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.3",
    "@yao-pkg/pkg": "^6.20.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "earth.ramble.app",
    "productName": "Ramble",
    "files": [
      "electron/**",
      "server.js",
      "public/**",
      "src-tauri/icons/32x32.png"
    ],
    "extraMetadata": {
      "type": "module"
    },
    "win": {
      "target": "nsis",
      "icon": "src-tauri/icons/icon.ico"
    }
  }
}
