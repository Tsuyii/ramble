{
  "name": "ramble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Say it. I'll sort it. — a voice brain-dump that turns rambling speech into clean, scheduled tasks.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "earth.ramble.app",
    "productName": "Ramble",
    "asar": false,
    "files": [
      "electron/**",
      "server.js",
      "public/**"
    ],
    "extraMetadata": {
      "type": "module"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
